PORT=4000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of allowed frontend origins.
# Example: http://localhost:3000,https://your-app.github.io
# Use * to allow all origins.
CORS_ORIGINS=*

# Free-tier usage limit for backend-owned Gemini key.
# Set to 0 for unlimited.
MONTHLY_ACTION_LIMIT=4

# Max JSON body size in MB (image uploads are base64 in JSON).
MAX_BODY_MB=12

# Gemini request timeout in milliseconds.
REQUEST_TIMEOUT_MS=30000
