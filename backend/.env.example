PORT=4000

# ── AI providers (model-agnostic) ─────────────────────────────────────
# Providers are tried in this order until one succeeds. Any provider
# without a key is skipped. Options: openai, gemini, zen.
LLM_PROVIDER_ORDER=openai,gemini,zen

# "openai" works with ANY OpenAI-compatible /chat/completions endpoint:
# OpenAI itself, OpenRouter, Ollama, vLLM, ... just change OPENAI_BASE_URL.
# The fast model handles query planning; the deep model handles image
# analysis. gpt-4.1-mini does both well and cheaply.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_DEEP_MODEL=gpt-4.1-mini

# Google Gemini (native API). Newer keys only have access to 3.x models.
# Free-tier keys are heavily throttled during demand spikes.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_DEEP_MODEL=gemini-3-pro-preview

# OpenCode Zen (OpenAI-compatible aggregator), optional.
# OPENCODE_ZEN_API_KEY=
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_ZEN_MODEL=gemini-3.5-flash
# OPENCODE_ZEN_DEEP_MODEL=claude-sonnet-5

# ── Unsplash ──────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=

# ── Server ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: http://localhost:3001,https://daiviknambiar.github.io
# Use * to allow all origins (local dev only).
CORS_ORIGINS=*

# Free AI runs per visitor per month (visitors are identified by hashed IP;
# the raw IP is never stored). 0 = unlimited. Failed searches are not charged,
# and visitors bringing their own key via x-gemini-api-key bypass this.
USER_MONTHLY_LIMIT=5

# Hard ceiling across ALL visitors per month, so the owner's bill is bounded.
# 0 = unlimited. (Legacy alias: MONTHLY_ACTION_LIMIT.)
GLOBAL_MONTHLY_LIMIT=300

# Set to 1 when deployed behind a reverse proxy (Render/Railway/Fly) so the
# per-visitor limit uses the real client IP from X-Forwarded-For.
TRUST_PROXY=0

# Where the SQLite cache lives (profile indexes, EXIF details).
# Safe to lose on redeploy; it is a cache.
# DATA_DIR=/var/data/splashboard

# Max JSON body size in MB (image uploads are base64 in JSON).
MAX_BODY_MB=12

# Per-request timeout for AI calls in milliseconds.
REQUEST_TIMEOUT_MS=60000
